{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "true",
    "CLAUDE_CODE_BASH_SANDBOX_SHOW_INDICATOR": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_ARTIFACT": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SEND_FEEDBACK": "0",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "IS_DEMO": "1",
    "USER_HOOKS_PREFER_TVLY": "1",
    "USER_HOOKS_HINT_GIT_COMMIT_RULES": "1",
    "USER_HOOKS_HINT_GIT_TAG_CHANGELOG": "1",
    "USER_HOOKS_ASK_GIT_COMMIT": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "Bash(*)",
      "Bash(make:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(xargs:*)",
      "Bash(fi:*)",
      "Bash(done:*)",
      "Bash(for:*)",
      "Bash(pkill:*)"
    ],
    "deny": [
      "Bash(git stash:*)",
      "Bash(git stash pop:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "PowerShell(git commit:*)"
    ],
    "defaultMode": "plan",
    "additionalDirectories": [
      "~/tmp",
      "~/test"
    ]
  },
  "model": "sonnet",
  "skillOverrides": {
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "schedule": "user-invocable-only",
    "design": "user-invocable-only",
    "morning": "user-invocable-only",
    "import-memory": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-head-read.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-head-tail-pipe.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-bg-head-tail-pipe.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-heredoc.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-cat-write.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-background-ampersand.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-sed-print.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-git-amend.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-destructive-git.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-devnull-redirect.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-dangerous-ops.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-worktree-team.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/explore-model-sonnet.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-bg-unbuffered-python.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-pip-npm.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-multi-question.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/hint-agent-claude-code-guide.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/hint-skill-babysit.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/hint-skill-agent-browser.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-bare-python.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/no-global-npx-skills.py",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/hint-git-commit-rules.py",
            "shell": "bash",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/ask-git-commit.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/hint-git-tag-changelog.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/hint-python-unbuffered.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/hint-auto-bg-head-tail-pipe.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/hint-explore-results.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/hint-pep723-script.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/hint-websearch-followup.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/hint-fork-on-bloat.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/track-babysit-skill-load.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/track-sent-file.py",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/prefer-rg.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/prefer-fd.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/prefer-just.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/prefer-eza.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/prefer-tvly.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/inject-git-status.py",
            "shell": "bash",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/inject-system-load.py",
            "shell": "bash",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/block-note-prompt.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/compact-bump.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [],
    "Notification": [],
    "PermissionRequest": [],
    "PostToolUseFailure": [],
    "Stop": [],
    "StopFailure": [],
    "SessionEnd": []
  },
  "worktree": {
    "baseRef": "head"
  },
  "defaultShell": "powershell",
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "shuorenhua@shuorenhua": true,
    "guard-hud@guard-hud": true
  },
  "extraKnownMarketplaces": {
    "shuorenhua": {
      "source": {
        "source": "github",
        "repo": "MrGeDiao/shuorenhua"
      }
    },
    "guard-hud": {
      "source": {
        "source": "directory",
        "path": "~/.claude/mods/guard-hud"
      }
    }
  },
  "language": "chinese",
  "subagentPromptCacheTtl": "5m",
  "modelSettings": {
    "glm-5.3": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "autoScrollEnabled": true,
  "fileCheckpointingEnabled": true
}
